@page "/teachers/add"
@using Jedster.UseCases.Professores.Interfaces

@inject IRegisterTeacherUsecase RegisterTeacherUsecase;
@inject NavigationManager Navigator;

<h3>Preencha os dados do professor</h3>

<EditForm Model="teacher" FormName="RegistryForm" OnValidSubmit="Save">
    <DataAnnotationsValidator></DataAnnotationsValidator>

    <div class="form-group">
        <label for="name">Nome</label>
        <InputText id="name" @bind-Value="teacher.Name" class="form-control">
        </InputText>
        <ValidationMessage For="() => teacher.Name"></ValidationMessage>
    </div>
    <div class="form-group">
        <label for="BirthDate">Data de nascimento</label>
        <InputDate id="BirthDate" @bind-Value="teacher.BirthDate" class="form-control">
        </InputDate>
        <ValidationMessage For="() => teacher.BirthDate"></ValidationMessage>
    </div>
    <div class="form-group">
        <label for="CPF">CPF</label>
        <InputText id="CPF" @bind-Value="teacher.CPF" class="form-control">
        </InputText>
        <ValidationMessage For="() => teacher.CPF"></ValidationMessage>
    </div>
    <div class="form-group">
        <label for="RG">RG</label>
        <InputText id="RG" @bind-Value="teacher.RG" class="form-control">
        </InputText>
        <ValidationMessage For="() => teacher.RG"></ValidationMessage>
    </div>

    <div class="form-group">
        <label for="email">Email</label>
        <InputText id="email" @bind-Value="teacher.Email" class="form-control">
        </InputText>
        <ValidationMessage For="() => teacher.Email"></ValidationMessage>
    </div>

    <div class="form-group">
        <label for="hours">Horas por semana</label>
        <InputNumber id="hours" @bind-Value="teacher.Hours" class="form-control">
        </InputNumber>
    </div>
    <br/>
    <button type="submit" class="btn btn-primary">Salvar</button>
    &nbsp;
    <a href="/teachers" class="btn btn-danger">Cancel</a>
</EditForm>






@code {
    [SupplyParameterFromForm] private Teacher teacher { get; set; } = new Teacher();

    private async Task Save()
    {
        await RegisterTeacherUsecase.ExecuteAsync(teacher);
        Navigator.NavigateTo("/teachers");
    }


}
