@page "/"
@inject IViewTeacherUseCase ViewTeacherUseCase


<PageTitle>Test Page</PageTitle>

<br />
<br />

<table class="table">
    <tr>
        <th>id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Work Hours</th>
    </tr>
    @if (teachers is not null && teachers.Count > 0)
    {
        foreach (Teacher teacher in teachers)
        {
            <tr>
                <td>
                    @teacher.TeacherId
                </td>

                <td>
                    @teacher.Name
        
                </td>

                <td>
                    @teacher.Email
        
                </td>

                <td>
                    @teacher.Hours
        
                </td>

            </tr>
        }
    }
</table>
@code {
    private List<Teacher>? teachers;

    protected override async Task OnInitializedAsync()
    {
       teachers = (await ViewTeacherUseCase.ExecuteAsync()).ToList();
        
    }
}