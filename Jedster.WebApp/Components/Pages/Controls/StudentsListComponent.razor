@using Jedster.CoreBusiness
@using Jedster.UseCases.Groups
@using Jedster.UseCases.PluginInterfaces
@using Jedster.UseCases.Students

@inject IViewStudentsUseCase ViewStudentsUseCase
@inject IEditGroupUseCase EditGroupUseCase
@inject IRegisterGroupUseCase RegisterGroupUseCase
@inject IDeleteGroupUseCase DeleteGroupUseCase

@inject NavigationManager Navigator

<MudDataGrid @ref="_dataGrid" T="Student" Items="@_students" Filterable="true"
             FilterMode="@_filterMode" FilterCaseSensitivity="@_caseSensitivity">
    
    <ToolBarContent>
        <MudText Typo="Typo.h6"> Turmas </MudText>
        <MudSpacer/>
        <MudButtonGroup Color="Color.Success" Variant="Variant.Filled">
            <MudButton Href="/turmas/add">
                Adicionar turma
            </MudButton>
        </MudButtonGroup>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.StudentId" Title="#" Filterable="true" Sortable="true" SortDirection="SortDirection.Ascending"/>
        <PropertyColumn Property="x => x.Name" Title="Nome de Aluno" Filterable="true" Sortable="true" SortDirection="SortDirection.Ascending"/>
        <PropertyColumn Property="x => x.BirthDate" Title="Data de nascimento" Filterable="true" />
        <PropertyColumn Property="x => x.GroupId.ToString() " Title="ID da turma" Filterable="true"/>
        <PropertyColumn Property="x => x.Contract" Title="Contrato" Filterable="false"/>
        <PropertyColumn Property="x => x.TextbookId" Title="ID de material" Filterable="true"/>
        <TemplateColumn Title="Actions" CellClass="d-flex justify-content-center">
            <CellTemplate>
                
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick=" () => RedirectToEdit(context.Item.StudentId)">
                        Editar
                    </MudButton>
              
            </CellTemplate>
            <EditTemplate>

            </EditTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Student" PageSizeOptions="new[] {5, 10, 15, 20}"/>
    </PagerContent>
</MudDataGrid>


@code {
    private bool _isCellEditMode = false;
    private bool _editTriggerRowClick = false;
    private  List<Student> _students = [];
    private DataGridFilterMode _filterMode = DataGridFilterMode.Simple;
    private DataGridFilterCaseSensitivity _caseSensitivity = DataGridFilterCaseSensitivity.Default;
    private MudDataGrid<Student> _dataGrid = default!;

    protected override async Task OnInitializedAsync()
    {
        _students = (await ViewStudentsUseCase.ExecuteAsync()).ToList();
        
    }

    private async Task ResetGridAndFilters()
    {
        // reset external options
        _filterMode = DataGridFilterMode.Simple;
        _caseSensitivity = DataGridFilterCaseSensitivity.Default;
        // reset all active filters and sorting
        await _dataGrid.ClearFiltersAsync();        
        foreach (var field in _dataGrid.SortDefinitions.Keys.ToList())
        {
            await _dataGrid.RemoveSortAsync(field);
        }
    }

    private Task EditRow(CellContext<Group> context)
    {
        throw new NotImplementedException();
    }

    public void RedirectToEdit(int groupId)
    {
        Navigator.NavigateTo(($"/edit-turma/{groupId}"));
    }
}
