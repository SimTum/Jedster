@using Jedster.CoreBuisness
@using Jedster.UseCases.Teachers.Interfaces
@using Microsoft.EntityFrameworkCore.Metadata.Internal

@inject IViewTeacherUseCase ViewTeacherUseCase
@inject IDeleteTeacherUseCase DeleteTeacherUseCase
@inject IEditTeacherUseCase UpdateTeacherUseCase
@inject NavigationManager Navigation


<MudCard Elevation="2" Class="my-3">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.body2">
                <MudIcon Icon="@Icons.Material.Filled.Person" class="mr-2"/>
                Professores
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <div class="d-flex align-items-center gap-2">
                
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Add" 
                           Href="/teacher/add">
                    <MudText>Adicionar Professor</MudText>
                </MudButton>
            </div>
        </CardHeaderActions>
    </MudCardHeader>
</MudCard>

<MudTable T="Teacher" Items="@_teachers" Hover="true" Striped="true" Filter="FilterUsers">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Search table</MudText>
        <MudSpacer/>
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Search"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"/>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>id</MudTh>
        <MudTh>Nome</MudTh>
        <MudTh>Data de Nascimento</MudTh>
        <MudTh>CPF</MudTh>
        <MudTh>RG</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Horas de trabalho</MudTh>
    </HeaderContent>
    <RowTemplate>

        <MudTd DataLabel="id"> @context.TeacherId</MudTd>
        <MudTd DataLabel="Name"> @context.Name</MudTd>
        <MudTd DataLabel="Birth Date"> @context.BirthDate</MudTd>
        <MudTd DataLabel="CPF"> @context.CPF</MudTd>
        <MudTd DataLabel="RG"> @context.RG </MudTd>
        <MudTd DataLabel="Email"> @context.Email</MudTd>
        <MudTd DataLabel="Hours"> @context.Hours</MudTd>
        <MudTd DataLabel="Buttons">
            <a class="btn btn-secondary mb-3" href="/editProfessor/@context.TeacherId">Edit</a>
            <button class="btn btn-danger mb-3" @onclick="() => DeleteTeacher(context.TeacherId)">Delete</button>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>

@code {
    private List<Teacher>? _teachers;
    [Parameter] public string _searchString { get; set; } = "";

    private bool FilterUsers(Teacher teacher) =>
        string.IsNullOrWhiteSpace(_searchString) ||
        teacher.Name.ToLower().Contains(_searchString.ToLower());

    protected override async Task OnInitializedAsync()
    {
        _teachers = (await ViewTeacherUseCase.ExecuteAsync()).ToList();
        foreach (var teacher in _teachers)
        {
            teacher.Hours = 0;
            foreach (var group in teacher.Groups)
            {
                teacher.Hours += (group.EndTime - group.StartTime).TotalHours;
            }

            await UpdateTeacherUseCase.ExecuteAsync(teacher);
        }
    }

    private async Task DeleteTeacher(int teacherId)
    {
        await DeleteTeacherUseCase.ExecuteAsync(teacherId);
        Navigation.Refresh(forceReload: true);
    }

}