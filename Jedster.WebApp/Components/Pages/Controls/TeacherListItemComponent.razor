@using System.Net.NetworkInformation

@if (this.teacher is not null) {

<tr>
    <td>
        @teacher.TeacherId
    </td>

    <td>
        @teacher.Name
    </td>

    <td>
        @teacher.Email
    </td>

    <td>
        @teacher.Hours
    </td>
                    
    <td>
        <button class="btn btn-success">Editar</button>
        <button class="btn btn-danger">Apagar</button>
    </td>

</tr>
}
@code {
    [Parameter]
    public Teacher? teacher { get; set; }

}
