@using Jedster.CoreBuisness
@using Microsoft.EntityFrameworkCore.Metadata.Internal



<MudTable T="Lesson" Items="@_lessons" Hover="true" Striped="true" >
    <ToolBarContent>
        <MudText Typo="Typo.h6">Search table</MudText>
        <MudSpacer/>
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Search"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"/>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>id</MudTh>
        <MudTh>Nome</MudTh>
        <MudTh>Data de Nascimento</MudTh>
        <MudTh>CPF</MudTh>
        <MudTh>RG</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Horas de trabalho</MudTh>
    </HeaderContent>
    <RowTemplate>

        <MudTd DataLabel="Buttons">
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>

@code {
    private List<Lesson>? _lessons;
    [Parameter] public string _searchString { get; set; } = "";
    
    protected override async Task OnInitializedAsync()
    {
     
    }

}